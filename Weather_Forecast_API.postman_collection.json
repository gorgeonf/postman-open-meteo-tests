    {
      "name": "Boundary Tests",
      "item": [
        {
          "name": "longitude boundaries 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const testValues = [180, -180];\r",
                  "\r",
                  "testValues.forEach(lon => {\r",
                  "    pm.sendRequest({\r",
                  "        url: `https://api.open-meteo.com/v1/forecast?latitude=-33.87&longitude=${lon}`,\r",
                  "        method: \"GET\"\r",
                  "    }, function (err, res) {\r",
                  "\r",
                  "        const body = res.json();\r",
                  "\r",
                  "        pm.test(`Status for longitude ${lon}`, function () {\r",
                  "            pm.expect(res.code).to.eql(200);\r",
                  "        });\r",
                  "\r",
                  "        pm.test(`Longitude is valid number`, function () {\r",
                  "            pm.expect(body.longitude).to.be.a(\"number\");\r",
                  "            actual = body.longitude;\r",
                  "            const isEquivalent =\r",
                  "                actual === lon ||\r",
                  "                (lon === 180 && actual === -180) ||\r",
                  "                (lon === -180 && actual === 180);\r",
                  "\r",
                  "            pm.expect(isEquivalent).to.be.true;\r",
                  "        });\r",
                  "\r",
                  "    });\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}",
              "host": [
                "{{base_url}}"
              ]
            }
          },
          "response": []
        },
