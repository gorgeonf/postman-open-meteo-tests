      "name": "Invalid requests",
      "item": [
        {
          "name": "Invalid timezone",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let response = {};\r",
                  "\r",
                  "pm.test(\"Response is valid JSON\", function () {\r",
                  "    try {\r",
                  "        response = pm.response.json();\r",
                  "    } catch (e) {\r",
                  "        pm.expect.fail(\"Response is not valid JSON\");\r",
                  "    }\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status should be 400\", function () {\r",
                  "    pm.response.to.have.status(400);\r",
                  "});\r",
                  "\r",
                  "\r",
                  "pm.test(\"Error: invalid timezone\", function () {  \r",
                  "    pm.expect(response).to.have.property(\"error\");\r",
                  "    pm.expect(response).to.have.property(\"reason\");\r",
                  "    \r",
                  "    pm.expect(response.error).to.be.eql(true);\r",
                  "    pm.expect(response.reason).to.be.equal(\"Invalid timezone\")\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
